{
    "name": "basis-company/picodata",
    "description": "Picodata client for PHP: schema management, typed entities, SQL builder",
    "keywords": [
        "database",
        "sql",
        "orm",
        "picodata",
        "distributed",
        "sharding"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "dmitry krokhin",
            "email": "nekufa@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.2"
    },
    "suggest": {
        "ext-pgsql": "PostgreSQL wire transport to the Picodata pg endpoint"
    },
    "autoload": {
        "psr-4": {
            "Basis\\Picodata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Basis\\Picodata\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
